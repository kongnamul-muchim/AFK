<?xml version="1.0" encoding="utf-8"?>
<UXML xmlns="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="UnityEngine.UIElements ../UIElements.xsd">
    <!-- 설정 모달 -->
    <ui:VisualElement name="SettingsModal" class="modal" style="display: none;">
        <ui:VisualElement name="SettingsContent" class="modal-content settings-content">
            <ui:VisualElement name="SettingsModalHeader" class="modal-header">
                <ui:Label name="SettingsTitle" text="설정" class="modal-title" />
                <ui:Button name="CloseSettingsBtn" text="×" class="modal-close" />
            </ui:VisualElement>
            <ui:ScrollView name="SettingsBody" class="settings-body" horizontal-scrolling="false" vertical-scrolling="true">
                <ui:VisualElement name="SettingsSection" class="settings-section">
                    <ui:Label text="사운드 설정" class="settings-section-title" />
                    
                    <ui:VisualElement name="SfxVolumeRow" class="setting-row">
                        <ui:Label text="효과음 볼륨" class="setting-label" />
                        <ui:Slider name="SfxVolumeSlider" class="setting-slider" min="0" max="1" value="1" />
                        <ui:Label name="SfxVolumeValue" text="100%" class="setting-value" />
                    </ui:VisualElement>
                    
                    <ui:VisualElement name="BgmVolumeRow" class="setting-row">
                        <ui:Label text="배경음악 볼륨" class="setting-label" />
                        <ui:Slider name="BgmVolumeSlider" class="setting-slider" min="0" max="1" value="1" />
                        <ui:Label name="BgmVolumeValue" text="100%" class="setting-value" />
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <ui:VisualElement name="DataSection" class="settings-section">
                    <ui:Label text="데이터 관리" class="settings-section-title" />
                    
                    <ui:Button name="SaveDataBtn" text="데이터 저장" class="setting-button" />
                    <ui:Button name="ResetDataBtn" text="데이터 초기화" class="setting-button danger" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</UXML>
