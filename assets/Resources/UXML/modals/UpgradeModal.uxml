<?xml version="1.0" encoding="utf-8"?>
<UXML xmlns="UnityEngine.UIElements" xmlns:ui="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="UnityEngine.UIElements ../UIElements.xsd">
    <!-- 업그레이드 모달 -->
    <ui:VisualElement name="UpgradeModal" class="modal" style="display: none;">
        <ui:VisualElement name="UpgradeModalContent" class="modal-content upgrade-modal-content">
            <ui:VisualElement name="UpgradeModalHeader" class="modal-header">
                <ui:Label name="UpgradeTitle" text="업그레이드" class="modal-title" />
                <ui:Button name="CloseUpgradeBtn" text="×" class="modal-close" />
            </ui:VisualElement>
            <ui:VisualElement name="UpgradeHeader" class="upgrade-header">
                <ui:Label name="UpgradePointsDisplay" text="⭐ 0" class="stat-points-display" style="display: none;" />
                <ui:Label name="UpgradeGoldDisplay" text="💰 0" class="upgrade-gold-display" style="display: none;" />
                <ui:Label name="UpgradeGemsDisplay" text="💎 0" class="gems-display" style="display: none;" />
            </ui:VisualElement>
            <ui:VisualElement name="UpgradeTabs" class="upgrade-tabs">
                <ui:Button name="UpgradeTabGold" text="골드" class="tab-btn active" />
                <ui:Button name="UpgradeTabStat" text="스탯" class="tab-btn" />
                <ui:Button name="UpgradeTabGem" text="💎 보석" class="tab-btn" />
                <ui:Button name="UpgradeTabRebirth" text="환생" class="tab-btn" />
            </ui:VisualElement>
            <ui:ScrollView name="UpgradeGrid" class="upgrade-list" show-vertical-scroller="false" horizontal-scrolling="false" vertical-scrolling="true">
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</UXML>
