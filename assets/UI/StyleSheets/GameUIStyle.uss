/* Unity 6 (6000.3.9f1) 호환 스타일시트 - FHD 최적화 */

:root {
    --color-bg-primary: #0f0f1a;
    --color-bg-secondary: #1a1a2e;
    --color-bg-tertiary: #252542;
    --color-text-primary: #ffffff;
    --color-text-secondary: #b0b0c0;
    --color-accent: #4a9eff;
    --color-accent-dark: #2d7dd2;
    --color-success: #4ade80;
    --color-warning: #fbbf24;
    --color-danger: #f87171;
    --color-hp: #ef4444;
    --color-exp: #8b5cf6;
    --color-gold: #fbbf24;
}

/* 로딩 화면 */
.loading-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg-primary);
    justify-content: center;
    align-items: center;
}

.loading-content {
    -unity-text-align: middle-center;
    padding: 75px;
    max-width: 1000px;
}

.loading-logo {
    font-size: 80px;
    -unity-font-style: bold;
    color: var(--color-accent);
    margin-bottom: 60px;
}

.loading-progress {
    margin-bottom: 30px;
}

.loading-bar {
    height: 20px;
    background-color: var(--color-bg-tertiary);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 30px;
}

.loading-bar-fill {
    height: 100%;
    background-color: var(--color-accent);
    width: 0%;
}

.loading-percent {
    color: var(--color-text-secondary);
    font-size: 35px;
}

.loading-tip {
    color: var(--color-text-secondary);
    font-size: 32px;
    min-height: 50px;
}

.loading-version {
    color: var(--color-text-secondary);
    font-size: 30px;
    opacity: 0.7;
}

.loading-retry {
    margin-top: 40px;
    padding: 30px 80px;
    background-color: var(--color-accent);
    color: white;
    border-radius: 8px;
    -unity-font-style: bold;
    font-size: 40px;
}

/* 게임 컨테이너 */
.game-container {
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--color-bg-primary);
}

/* HUD 상단 */
.hud-top {
    flex-direction: row;
    gap: 20px;
    align-items: center;
    padding: 20px 30px;
    background-color: var(--color-bg-secondary);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-bg-tertiary);
    min-height: 120px;
}

.player-info {
    flex: 1;
    flex-direction: row;
    align-items: center;
    gap: 20px;
}

.player-level {
    -unity-font-style: bold;
    color: var(--color-accent);
    font-size: 35px;
    white-space: nowrap;
}

.hp-bar-container {
    flex: 1;
    height: 40px;
    background-color: var(--color-bg-tertiary);
    border-radius: 20px;
    overflow: hidden;
}

.hp-bar-fill {
    height: 100%;
    background-color: var(--color-hp);
    width: 100%;
}

.hp-text {
    color: var(--color-text-primary);
    font-size: 30px;
    white-space: nowrap;
}

.stage-info {
    flex-direction: row;
    align-items: center;
    gap: 20px;
}

/* 스테이지 정보 바 (메인 화면 상단 중앙) */
.stage-info-bar {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 20px;
    padding: 15px 30px;
    background-color: var(--color-bg-secondary);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-bg-tertiary);
}

.stage-text {
    -unity-font-style: bold;
    color: var(--color-text-primary);
    font-size: 40px;
}

.auto-repeat-btn {
    width: 70px;
    height: 70px;
    background-color: var(--color-bg-tertiary);
    border-radius: 12px;
    font-size: 36px;
    justify-content: center;
    align-items: center;
}

.right-info {
    flex: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    gap: 20px;
}

.gold-info {
    flex-direction: row;
    align-items: center;
    gap: 10px;
}

.gold-icon {
    font-size: 45px;
}

.gold-text {
    color: var(--color-gold);
    -unity-font-style: bold;
    font-size: 35px;
}

.settings-btn {
    width: 90px;
    height: 90px;
    background-color: var(--color-bg-tertiary);
    border-radius: 12px;
    font-size: 45px;
    justify-content: center;
    align-items: center;
}

/* 아이템 드롭 이펙트 */
.item-drop-effects {
    position: absolute;
    top: 150px;
    left: 50%;
    flex-direction: column;
    align-items: center;
    gap: 20px;
}

/* 버프 표시 영역 */
.buff-display {
    flex-direction: row;
    padding: 10px 20px;
    gap: 10px;
    min-height: 80px;
}

/* 게임 뷰 */
.game-view {
    flex: 1;
    position: relative;
    background-color: var(--color-bg-primary);
}

.game-canvas {
    width: 100%;
    height: 100%;
}

.combat-log {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    max-height: 250px;
    padding: 20px;
    background-color: rgba(0, 0, 0, 0.7);
    overflow: hidden;
}

/* HUD 하단 */
.hud-bottom {
    padding: 20px 30px;
    background-color: var(--color-bg-secondary);
    border-top-width: 1px;
    border-top-color: var(--color-bg-tertiary);
}

.exp-bar-container {
    height: 30px;
    background-color: var(--color-bg-tertiary);
    border-radius: 15px;
    overflow: hidden;
    margin-bottom: 10px;
}

.exp-bar-fill {
    height: 100%;
    background-color: var(--color-exp);
    width: 0%;
}

.bottom-stats {
    flex-direction: row;
    justify-content: space-between;
}

.stat-text {
    color: var(--color-text-secondary);
    font-size: 30px;
}

.stat-points {
    color: var(--color-warning);
    -unity-font-style: bold;
    font-size: 30px;
}

/* 메뉴 버튼들 */
.menu-buttons {
    flex-direction: row;
    justify-content: space-around;
    padding: 20px;
    background-color: var(--color-bg-secondary);
    border-top-width: 1px;
    border-top-color: var(--color-bg-tertiary);
}

.menu-btn {
    flex: 1;
    padding: 30px 20px;
    background-color: var(--color-accent);
    color: white;
    border-radius: 8px;
    -unity-font-style: bold;
    font-size: 35px;
    margin: 0 10px;
}

.menu-btn:hover {
    background-color: var(--color-accent-dark);
}

.menu-btn:active {
    background-color: #1a6ab5;
}

/* 모달 공통 스타일 */
.modal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    justify-content: center;
    align-items: center;
}

.modal-content {
    background-color: var(--color-bg-secondary);
    border-radius: 30px;
    padding: 50px;
    min-width: 750px;
    max-width: 90%;
    max-height: 80%;
}

.inventory-modal-content {
    min-width: 1000px;
    max-width: 95%;
}

.modal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
}

.modal-title {
    font-size: 50px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
}

.modal-close {
    width: 80px;
    height: 80px;
    background-color: var(--color-bg-tertiary);
    border-radius: 12px;
    font-size: 50px;
    justify-content: center;
    align-items: center;
    color: var(--color-text-primary);
}

/* 장비 패널 */
.equipment-panel {
    flex-direction: column;
    gap: 15px;
    margin-bottom: 30px;
}

/* 장비 슬롯 행 */
.equipment-slots-row {
    flex-direction: row;
    gap: 10px;
    justify-content: space-between;
}

.equipment-slot {
    flex: 1;
    min-height: 180px;
    background-color: var(--color-bg-tertiary);
    border-radius: 12px;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding: 15px;
}

.slot-label {
    color: var(--color-text-secondary);
    font-size: 26px;
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.slot-item {
    width: 100px;
    height: 100px;
    background-color: var(--color-bg-secondary);
    border-radius: 6px;
}

/* 스탯 보너스 행 */
.stats-bonus-row {
    flex-direction: row;
    gap: 10px;
    justify-content: space-between;
}

.stat-bonus-card {
    flex: 1;
    min-height: 70px;
    background-color: var(--color-bg-tertiary);
    border-radius: 12px;
    justify-content: center;
    align-items: center;
    padding: 10px 15px;
}

.bonus-stat {
    color: var(--color-text-secondary);
    font-size: 22px;
    -unity-text-align: middle-center;
}

/* 인벤토리 탭 */
.inventory-tabs {
    flex-direction: row;
    gap: 10px;
    margin-bottom: 30px;
}

.tab-btn {
    flex: 1;
    padding: 20px;
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-primary);
    border-radius: 12px;
    font-size: 32px;
}

.tab-btn.active {
    background-color: var(--color-accent);
}

/* 일괄합성 바 */
.batch-synthesize-bar {
    flex-direction: row;
    margin-bottom: 30px;
}

.batch-synthesize-btn {
    flex: 1;
    padding: 18px 30px;
    background-color: var(--color-warning);
    color: #000;
    border-radius: 8px;
    -unity-font-style: bold;
    font-size: 30px;
}

/* 아이템 그리드 */
.items-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    max-height: 500px;
    overflow: hidden;
    margin-bottom: 30px;
}

/* 골드 표시 */
.gold-display {
    flex-direction: row;
    justify-content: space-between;
    padding: 20px;
    background-color: var(--color-bg-tertiary);
    border-radius: 12px;
}

.gold-display-label {
    color: var(--color-text-secondary);
    font-size: 32px;
}

.gold-display-value {
    color: var(--color-gold);
    -unity-font-style: bold;
    font-size: 35px;
}

/* 아이템 툴팁 */
.item-tooltip {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.95);
    border-radius: 12px;
    padding: 30px;
    min-width: 500px;
}

.tooltip-name {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-bottom: 10px;
}

.tooltip-grade {
    font-size: 30px;
    color: var(--color-accent);
    margin-bottom: 20px;
}

.tooltip-stats {
    margin-bottom: 20px;
}

.tooltip-actions {
    flex-direction: column;
    gap: 10px;
}

.tooltip-action {
    color: var(--color-text-secondary);
    font-size: 28px;
}

/* 설정 콘텐츠 */
.settings-content {
    flex-direction: column;
    gap: 30px;
}

.setting-row {
    flex-direction: row;
    align-items: center;
    gap: 30px;
}

.setting-label {
    min-width: 200px;
    color: var(--color-text-primary);
    font-size: 35px;
}

.setting-slider {
    flex: 1;
    height: 50px;
}

.setting-value {
    min-width: 100px;
    color: var(--color-text-secondary);
    font-size: 32px;
    -unity-text-align: middle-right;
}

.setting-toggle {
    width: 100px;
    height: 50px;
}

.data-btn {
    flex: 1;
    padding: 20px;
    background-color: var(--color-bg-tertiary);
    color: var(--color-text-primary);
    border-radius: 12px;
    font-size: 32px;
}

.data-btn.danger {
    background-color: var(--color-danger);
    color: white;
}

/* 업그레이드 모달 */
.upgrade-modal-content {
    min-width: 1000px;
}

.upgrade-header {
    flex-direction: row;
    justify-content: space-around;
    margin-bottom: 30px;
}

.stat-points-display {
    color: var(--color-warning);
    -unity-font-style: bold;
    font-size: 35px;
}

.gems-display {
    color: var(--color-accent);
    -unity-font-style: bold;
    font-size: 35px;
}

.upgrade-tabs {
    flex-direction: row;
    gap: 10px;
    margin-bottom: 40px;
}

.upgrade-grid {
    flex-direction: column;
    gap: 20px;
    max-height: 750px;
}

/* 미션 모달 */
.daily-missions-content {
    min-width: 875px;
}

.missions-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 30px;
}

.reset-timer {
    color: var(--color-text-secondary);
    font-size: 32px;
}

.missions-tabs {
    flex-direction: row;
    gap: 10px;
    margin-bottom: 40px;
}

.missions-grid {
    flex-direction: column;
    gap: 20px;
    max-height: 750px;
}

/* 보석 상점 */
.gem-shop-content {
    min-width: 875px;
}

.shop-header {
    margin-bottom: 40px;
}

.gem-shop-grid {
    flex-direction: column;
    gap: 20px;
    max-height: 750px;
}

/* 오프라인 보상 */
.offline-content {
    flex-direction: column;
    gap: 30px;
}

.offline-time {
    font-size: 40px;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
}

.offline-rewards {
    flex-direction: column;
    gap: 10px;
    padding: 30px;
    background-color: var(--color-bg-tertiary);
    border-radius: 12px;
}

.offline-equipment {
    flex-direction: column;
    gap: 20px;
}

.offline-equipment-list {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
}

.confirm-btn {
    padding: 30px;
    background-color: var(--color-accent);
    color: white;
    border-radius: 12px;
    -unity-font-style: bold;
    font-size: 40px;
}

/* 통계 모달 */
.statistics-modal-content {
    min-width: 1000px;
    max-height: 85%;
}

.statistics-content {
    flex-direction: column;
    gap: 35px;
    max-height: 1500px;
    overflow: hidden;
}

.stats-section {
    flex-direction: column;
    gap: 12px;
}

.stats-section-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: var(--color-accent);
    padding: 8px 15px;
    background-color: var(--color-bg-tertiary);
    border-radius: 8px;
    margin-bottom: 5px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
}

.stat-card {
    flex-direction: column;
    background-color: var(--color-bg-tertiary);
    border-radius: 12px;
    padding: 15px 8px;
    align-items: center;
    justify-content: center;
    min-height: 100px;
    width: 100%;
}

.stat-card-label {
    color: var(--color-text-secondary);
    font-size: 22px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.stat-card-value {
    color: var(--color-text-primary);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* 튜토리얼 오버레이 */
.tutorial-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    justify-content: center;
    align-items: center;
}

.tutorial-guide {
    background-color: var(--color-bg-secondary);
    border-radius: 30px;
    padding: 60px;
    max-width: 1000px;
    -unity-text-align: middle-center;
}

.tutorial-message {
    font-size: 40px;
    color: var(--color-text-primary);
    margin-bottom: 50px;
    min-height: 60px;
}

.tutorial-next {
    padding: 30px 80px;
    background-color: var(--color-accent);
    color: white;
    border-radius: 12px;
    -unity-font-style: bold;
    font-size: 40px;
}